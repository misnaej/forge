{
  "permissions": {
    "allow": [
      "Bash(forge-doctor)",
      "Bash(forge-doctor *)",
      "Bash(forge-precommit)",
      "Bash(forge-precommit *)",
      "Bash(forge-smart-test *)",
      "Bash(verify-forge-docstrings *)",
      "Bash(verify-forge-agent-doc)",
      "Bash(verify-forge-agent-doc *)",
      "Bash(verify-forge-repo-structure)",
      "Bash(forge-next-prep *)",
      "Bash(forge-audit-all *)",
      "Bash(forge-audit-claims *)",
      "Bash(forge-audit-data *)",
      "Bash(forge-audit-deps *)",
      "Bash(forge-audit-dup *)",
      "Bash(forge-audit-orphans *)",
      "Bash(forge-audit-suppressions *)",
      "Bash(forge-audit-agents *)",
      "Bash(forge-gen-cli-reference)",
      "Bash(forge-gen-api-digest)",
      "Bash(forge-gen-commit-types)",
      "Bash(forge-continuation *)",
      "Bash(forge-pr-squash-comment *)",
      "Bash(install-forge-githooks *)",
      "Bash(install-forge-claude-md *)",
      "Bash(install-forge-labels)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_agent_timing.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_continuation_budget.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_continuation_budget.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_continuation_budget.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/keep_squash_comment_last.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/warn_stale_wrapup.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/warn_merge_conflicts.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/keep_continuation_state.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_protected_branches.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_force_push.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_git_rebase.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_git_destructive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_amend_pushed_commit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_pr_merge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_unverified_pr_create.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_branch_deletion.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_no_verify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_install_deps.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_claude_attribution.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_continuation_delete.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/check_commit_format.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/warn_pr_checks.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_raw_ruff.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_raw_git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_raw_wrapup_post.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_fixer_recon.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/block_vibe_config.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_protected_files.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_forge_docs_edits.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_vibe_config.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_protected_files.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_forge_docs_edits.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block_vibe_config.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_agent_timing.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman_mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_foundation_sync.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/load_continuation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman_mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_agent_timing.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/require_helpers_stopped.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^forge\\-precommit\\-fixer$",
        "hooks": [
          {
            "type": "command",
            "command": "FORGE_HOOK_AGENT=forge-precommit-fixer ${CLAUDE_PROJECT_DIR}/.claude/hooks/require_fixer_verdict.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
