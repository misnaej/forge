{
  "enabledPlugins": {
    "forge@forge": true
  },
  "extraKnownMarketplaces": {
    "forge": {
      "source": {
        "source": "github",
        "repo": "misnaej/forge",
        "ref": "dev"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(forge-doctor)",
